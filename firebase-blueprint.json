{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role-based permissions in Tatkal Assist Pro",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "operator", "passenger"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "department": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Marker document designating verified system administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "grantedAt": { "type": "string" },
        "grantedBy": { "type": "string" }
      },
      "required": ["uid", "grantedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security audit log of admin operations and user provisioning",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "targetUserEmail": { "type": "string" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "action", "performedBy", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and account authorizations"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Designated system administrator credentials"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit logs of administrative actions"
    }
  }
}
